# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.
GEMINI_API_KEY=your_key_here

# Optional overrides (defaults shown)
# APP_NAME=Anthony's Study Assistant
# MAX_UPLOAD_MB=50
# EMBED_TEXTS_PER_MINUTE=90
# GEMINI_TIMEOUT_SECONDS=45
# EMBED_MODEL=gemini-embedding-001
# CHAT_MODEL=gemini-3.5-flash
# CHAT_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
# CHROMA_PATH=chroma_db
# DATA_DIR=data
# SESSION_HOURS=12
# COOKIE_SECURE=true
# ASK_PER_MINUTE=20
# COLLECTION_NAME=lecture_notes
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150
# PAGE_LIMIT=2400
# PER_SOURCE_K=2
# TOP_K=8
# MAX_DISTANCE=0.38
